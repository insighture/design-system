{
  "name": "@insighture/design-system",
  "version": "0.1.0",
  "description": "Insighture design system — tokens, primitives and React components.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css",
    "./logo/*": "./brand/logo/*"
  },
  "files": [
    "dist",
    "brand/logo"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "preview": "vite --config vite.preview.config.ts",
    "clean": "rm -rf dist",
    "readme:assets": "node scripts/readme-scenes/shoot.mjs",
    "templates": "node scripts/templates/build.mjs",
    "templates:preview": "node scripts/templates/preview.mjs",
    "skill": "node scripts/skill/build.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "docx": "^9.5.1",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "playwright": "^1.49.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
